{
  "expo": {
    "name": "Hobby",
    "slug": "hobby-discovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hobby",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hobbydiscovery.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.hobbydiscovery.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8EF"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#165D4D",
          "defaultChannel": "reminders",
          "enableRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hobby uses the camera so you can save photos of what you make.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "21feadea-7892-41de-8280-64df8e0ae46a"
      }
    },
    "owner": "roni1306"
  }
}
